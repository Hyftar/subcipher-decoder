# Copy to deploy/.env and fill in (git ignores it). Read by scripts/deploy.sh.
# For continuous deployment, each variable is a secret of the GitHub
# "production" environment instead (see README, "Continuous deployment").

# Database password (any long random string; only used inside the stack).
POSTGRES_PASSWORD=change-me

# Signs sessions and cookies: 64+ random characters, e.g. `mix phx.gen.secret`
# or `openssl rand -base64 48`. Keep it secret; changing it logs everyone out.
SECRET_KEY_BASE=

# The address people use to reach the app, as typed in the browser.
# On the local network, without a proxy: http://192.168.1.50:4000
PHX_HOST=192.168.1.50
PHX_SCHEME=http
PHX_URL_PORT=4000
# Behind a reverse proxy with HTTPS instead:
#   PHX_HOST=subcipher.example.com
#   PHX_SCHEME=https
#   PHX_URL_PORT=443
# Other addresses allowed for live updates (comma separated), e.g. a host
# name of the server: //mediaserver.local:4000
PHX_CHECK_ORIGIN=

# Port published on the host.
APP_PORT=4000

# Email (sign-in links). Any SMTP provider works.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# STARTTLS: always, never or if_available. SMTP_SSL=true for port 465.
SMTP_TLS=if_available
SMTP_SSL=false
MAIL_FROM=subcipher@example.com
MAIL_FROM_NAME=Subcipher

# Image to run (the default is built from the main branch by GitHub Actions).
# SUBCIPHER_IMAGE=ghcr.io/hyftar/subcipher-decoder:latest
